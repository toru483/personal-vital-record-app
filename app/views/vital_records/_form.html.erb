<%= form_with(model: vital_record) do |form| %>
  <% if vital_record.errors.any? %>
    <div style="color: red;">
      <h2><%= vital_record.errors.count %>件のエラーが発生したため保存できませんでした:</h2>
      <ul>
        <% vital_record.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 💡 1. 記録日時の自動セット（新規作成時のみ現在時刻を入れる） %>
  <div style="margin-bottom: 15px;">
    <%= form.label :recorded_at, style: "display: block; font-weight: bold;" %>
    <%= form.datetime_field :recorded_at, value: vital_record.recorded_at || Time.current.strftime('%Y-%m-%dT%H:%M'), style: "padding: 5px; width: 200px;" %>
  </div>

  <%# 💡 2. 体重（スマホで小数点対応の数字キーボードを開く） %>
  <div style="margin-bottom: 15px;">
    <%= form.label :weight, style: "display: block; font-weight: bold;" %>
    <%= form.number_field :weight, step: "0.1", inputmode: "decimal", style: "padding: 5px; width: 100px;" %>
  </div>

  <%# 💡 3. 血糖値（スマホで整数専用の数字キーボードを開く） %>
  <div style="margin-bottom: 15px;">
    <%= form.label :blood_sugar, style: "display: block; font-weight: bold;" %>
    <%= form.number_field :blood_sugar, inputmode: "numeric", style: "padding: 5px; width: 100px;" %>
  </div>

  <%# 💡 4. 最高血圧（数字キーボード） %>
  <div style="margin-bottom: 15px;">
    <%= form.label :systolic_pressure, style: "display: block; font-weight: bold;" %>
    <%= form.number_field :systolic_pressure, inputmode: "numeric", style: "padding: 5px; width: 100px;" %>
  </div>

  <%# 💡 5. 最低血圧（数字キーボード） %>
  <div style="margin-bottom: 15px;">
    <%= form.label :diastolic_pressure, style: "display: block; font-weight: bold;" %>
    <%= form.number_field :diastolic_pressure, inputmode: "numeric", style: "padding: 5px; width: 100px;" %>
  </div>

  <%# 💡 6. メモ欄 %>
  <div style="margin-bottom: 20px;">
    <%= form.label :memo, style: "display: block; font-weight: bold;" %>
    <%= form.text_area :memo, rows: 3, style: "padding: 5px; width: 300px;" %>
  </div>

  <div>
    <%= form.submit style: "padding: 10px 20px; background-color: #28a745; color: white; border: none; border-radius: 5px; cursor: pointer;" %>
  </div>
<% end %>
