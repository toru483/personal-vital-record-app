<p style="color: green"><%= notice %></p>

<% content_for :title, "Vital records" %>

<h1>Vital records</h1>

<div id="vital_records">
  <% @vital_records.each do |vital_record| %>
    <%= render vital_record %>
    <p>
      <%= link_to "Show this vital record", vital_record %>
    </p>
  <% end %>
</div>

<%= link_to "New vital record", new_vital_record_path %>