<div id="<%= dom_id vital_record %>">
  <div>
    <strong>Recorded at:</strong>
    <%= vital_record.recorded_at %>
  </div>

  <div>
    <strong>Weight:</strong>
    <%= vital_record.weight %>
  </div>

  <div>
    <strong>Blood sugar:</strong>
    <%= vital_record.blood_sugar %>
  </div>

  <div>
    <strong>Systolic pressure:</strong>
    <%= vital_record.systolic_pressure %>
  </div>

  <div>
    <strong>Diastolic pressure:</strong>
    <%= vital_record.diastolic_pressure %>
  </div>

  <div>
    <strong>Memo:</strong>
    <%= vital_record.memo %>
  </div>

</div>
